# ===== Copia este archivo como ".env" en el servidor y completa los datos =====
APP_NAME="Mayo Viagens"
APP_ENV=production
APP_KEY=                      # se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos MySQL creada en hPanel (Bases de datos -> Bases de datos MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_mayo
DB_USERNAME=u123456789_mayo
DB_PASSWORD=pon_la_clave_aqui

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Datos legales (aparecen en Privacidad, Términos, ESNNA y Reclamaciones)
LEGAL_RUC=
LEGAL_EMAIL=

# Traducción automática de tours (opcional)
TRADUCTOR_PROVIDER=deepl
TRADUCTOR_KEY=
