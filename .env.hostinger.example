# ===== Copia este archivo como ".env" en el servidor y completa los datos =====
APP_NAME="Mayo Viagens"
APP_ENV=production
APP_KEY=                      # se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://mayoviagens.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos MySQL creada en hPanel (Bases de datos -> Bases de datos MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u505513466_mayo_db
DB_USERNAME=u505513466_mayoviagens
DB_PASSWORD=CAMBIAR_EN_HOSTINGER

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Datos legales (aparecen en Privacidad, Términos, ESNNA y Reclamaciones)
LEGAL_RUC=20616380355
LEGAL_EMAIL=MAYOVIAGENS@GMAIL.COM

# Traducción automática de tours (opcional)
TRADUCTOR_PROVIDER=deepl
TRADUCTOR_KEY=
